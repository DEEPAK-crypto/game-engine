<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="game-service"/>
    <springProperty scope="context" name="environment" source="spring.profiles.active" defaultValue="dev"/>

    <!-- Console Appender with JSON format -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC (Mapped Diagnostic Context) fields -->
            <includeMdc>true</includeMdc>

            <!-- Include context name -->
            <includeContext>true</includeContext>

            <!-- Include structured arguments -->
            <includeStructuredArguments>true</includeStructuredArguments>

            <!-- Include caller data (expensive, use only in dev) -->
            <includeCallerData>false</includeCallerData>

            <!-- Custom field names -->
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <level>level</level>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>

            <!-- Add custom fields -->
            <customFields>{"application":"${appName}","environment":"${environment}"}</customFields>

            <!-- Shorten logger names for readability -->
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- Standard Console Appender (non-JSON for development) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%15.15t] %-40.40logger{39} : %m%n%wEx</pattern>
        </encoder>
    </appender>

    <!-- Async wrapper for better performance -->
    <appender name="ASYNC_JSON_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_CONSOLE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- Development profile - human-readable logs -->
    <springProfile name="dev,default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <logger name="com.gameplatform.game" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.jooq" level="DEBUG"/>
    </springProfile>

    <!-- Staging profile - JSON logs with debug level -->
    <springProfile name="staging">
        <root level="INFO">
            <appender-ref ref="ASYNC_JSON_CONSOLE"/>
        </root>

        <logger name="com.gameplatform.game" level="DEBUG"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.jooq" level="INFO"/>
        <logger name="com.datastax.oss.driver" level="INFO"/>
    </springProfile>

    <!-- Production profile - JSON logs with warnings only -->
    <springProfile name="production,prod">
        <root level="WARN">
            <appender-ref ref="ASYNC_JSON_CONSOLE"/>
        </root>

        <logger name="com.gameplatform.game" level="INFO"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.jooq" level="WARN"/>
        <logger name="com.datastax.oss.driver" level="WARN"/>
        <logger name="io.micrometer" level="WARN"/>
    </springProfile>

    <!-- Specific loggers for database performance -->
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.postgresql" level="WARN"/>

    <!-- Actuator health checks should be quiet -->
    <logger name="org.springframework.boot.actuate.endpoint.web" level="WARN"/>
</configuration>